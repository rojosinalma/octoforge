# Octoforge environment: copy to `.env`. Only bootstrap values and secrets live here; everything
# tunable (secret lifetime, timeouts, log retention, theme…) is edited on the Settings page.

# --- Required: one of the two -------------------------------------------------------------------

# Password for the login page (signed session cookie). Octoforge refuses to start without it...
AUTH_PASSWORD=
# ...unless you set AUTH=none on purpose because a reverse proxy in front already authenticates
# every request. Never both.
#AUTH=none

# --- Required for credentials and database adoption ----------------------------------------------

# Shared bearer token for the member API: the same value goes into the .env of every member.
# At least 32 characters, e.g. `openssl rand -hex 32`. Without it only the index works.
OCTOFORGE_TOKEN=

# Public base URL of this Octoforge, as your browser reaches it. GitHub sends you back to
# <PUBLIC_URL>/github/callback after you create an App. Without it Apps cannot be created.
PUBLIC_URL=https://octoforge.example.com

# --- Optional ------------------------------------------------------------------------------------

# Random secret signing the session cookie (at least 32 characters). When empty, one is generated
# at first start and kept in DATA_DIR/session.secret.
SESSION_SECRET=

# Octoforge's own database. Default: SQLite at DATA_DIR/octoforge.db. A postgres:// URL puts its
# tables in the schema `forge` of that database instead. It never holds a credential.
#DATABASE_URL=postgres://octoforge:<password>@db.example.com:5432/octoforge

# Postgres role with CREATEROLE and CREATE on the shared database. Octoforge uses it to create one
# role and one schema per member when you adopt a member into Postgres. Empty = no Postgres adoption.
#FORGE_PG_ADMIN_URL=postgres://forge_admin:<password>@db.example.com:5432/octoforge

# Directory that holds one SQLite file per member, as the members see it (mount the same host
# directory into every member). Empty = no SQLite adoption.
#OCTOFORGE_SHARED_DATA=/shared

# Log verbosity: debug | info | warn | error | silent (default info). Lines on stdout.
LOG_LEVEL=info

# Listen port and data directory. The image sets PORT=3000 and DATA_DIR=/data; only change them for
# a run outside Docker.
#PORT=3000
#DATA_DIR=./data

# Built SPA and member list. The image sets both; locally they default to packages/web/dist and
# the repository's members.json (re-read when it changes; an invalid file stops the start-up).
#WEB_DIST=
#MEMBERS_FILE=

# Host side of the published port in compose.yaml (not read by the app). Defaults 0.0.0.0 and 3000.
#OCTOFORGE_BIND=0.0.0.0
#OCTOFORGE_PORT=3000
