#!/usr/bin/env bash
# Consistency and leak checks for the octoforge index. Exit 0 = healthy.
set -euo pipefail
cd "$(dirname "$0")/.."

errors=0
fail() { echo "verify: FAIL $*" >&2; errors=$((errors + 1)); }
note() { echo "verify: note $*"; }

owner_url='https://github.com/rojosinalma'

# README index: rows of the form | [tool](https://github.com/rojosinalma/tool) | ... |
mapfile -t readme_tools < <(grep -oE "^\| \[[a-z0-9-]+\]\(${owner_url}/[a-z0-9-]+\)" README.md \
  | sed -E 's/^\| \[([a-z0-9-]+)\]\(.*\/([a-z0-9-]+)\)$/\1 \2/' \
  | while read -r name repo; do
      [ "$name" = "$repo" ] || echo "MISMATCH:$name:$repo"
      echo "$name"
    done)
for t in "${readme_tools[@]}"; do
  case "$t" in MISMATCH:*) fail "README row ${t#MISMATCH:}: link text and repo name differ" ;; esac
done
mapfile -t readme_tools < <(printf '%s\n' "${readme_tools[@]}" | grep -v '^MISMATCH:' || true)
[ "${#readme_tools[@]}" -gt 0 ] || fail "README.md has no tool rows"

# .gitmodules: every submodule is a top-level folder named like its repo, with a homepage, listed in the README
submodules=()
if [ -f .gitmodules ]; then
  mapfile -t submodules < <(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' | awk '{print $2}')
fi
for m in "${submodules[@]}"; do
  [[ "$m" =~ ^[a-z0-9-]+$ ]] || fail "submodule $m: must be a top-level folder"
  url=$(git config -f .gitmodules --get "submodule.$m.url" || true)
  [[ "$url" =~ (github\.com[:/]rojosinalma/$m(\.git)?)$ ]] || fail "submodule $m: url $url does not point at rojosinalma/$m"
  git config -f .gitmodules --get "submodule.$m.homepage" >/dev/null || fail "submodule $m: no homepage key"
  printf '%s\n' "${readme_tools[@]}" | grep -qx "$m" || fail "submodule $m: no README index row"
done

# README rows that are not submodules yet are allowed, but reported
for t in "${readme_tools[@]}"; do
  printf '%s\n' "${submodules[@]}" | grep -qx "$t" || note "$t is in the index but not a submodule yet"
done

# Checkout: every submodule initialised and at the recorded commit
if [ "${#submodules[@]}" -gt 0 ]; then
  while read -r line; do
    case "$line" in
      -*) fail "submodule not initialised: ${line#-}" ;;
      +*) fail "submodule checkout differs from the recorded commit: ${line#+}" ;;
      U*) fail "submodule has merge conflicts: ${line#U}" ;;
    esac
  done < <(git submodule status)
fi

# Leaks in tracked files of this repo (submodules check themselves)
patterns=(
  '/home/[a-z_][a-z0-9_-]*/'
  '\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b[a-z0-9-]+\.(internal|lan|local)\b'
)
extra="${OCTOFORGE_LEAK_PATTERNS:-$(git rev-parse --git-path info/leak-patterns)}"
if [ -f "$extra" ]; then
  while IFS= read -r p; do [ -n "$p" ] && [ "${p#\#}" = "$p" ] && patterns+=("$p"); done < "$extra"
fi
for p in "${patterns[@]}"; do
  hits=$(git grep -nIE -e "$p" -- . ':!LICENSE' ':!bin/verify' 2>/dev/null | grep -v 'example\.internal' || true)
  [ -z "$hits" ] || fail "possible leak ($p):"$'\n'"$hits"
done

[ "$errors" -eq 0 ] || { echo "verify: $errors check(s) failed" >&2; exit 1; }
echo "verify: OK (${#readme_tools[@]} tools indexed, ${#submodules[@]} submodules)"
