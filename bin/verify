#!/usr/bin/env bash
# Full verification. Exit 0 = healthy.
#   1. index: README rows, .gitmodules and the checked-out submodules agree; no leaks in tracked files
#   2. app: install (frozen lockfile), typecheck, lint, tests, build
#   3. container: image build and a smoke test against /health (SKIP_DOCKER=1 skips it)
# Usage: bin/verify    (SKIP_APP=1 runs the index checks only)
set -euo pipefail
cd "$(dirname "$0")/.."

errors=0
fail() { echo "verify: FAIL $*" >&2; errors=$((errors + 1)); }
note() { echo "verify: note $*"; }

owner_url='https://github.com/rojosinalma'

# README index: rows of the form | [tool](https://github.com/rojosinalma/tool) | ... |
mapfile -t readme_tools < <(grep -oE "^\| \[[a-z0-9-]+\]\(${owner_url}/[a-z0-9-]+\)" README.md \
  | sed -E 's/^\| \[([a-z0-9-]+)\]\(.*\/([a-z0-9-]+)\)$/\1 \2/' \
  | while read -r name repo; do
      [ "$name" = "$repo" ] || echo "MISMATCH:$name:$repo"
      echo "$name"
    done)
for t in "${readme_tools[@]}"; do
  case "$t" in MISMATCH:*) fail "README row ${t#MISMATCH:}: link text and repo name differ" ;; esac
done
mapfile -t readme_tools < <(printf '%s\n' "${readme_tools[@]}" | grep -v '^MISMATCH:' || true)
[ "${#readme_tools[@]}" -gt 0 ] || fail "README.md has no tool rows"

# .gitmodules: every submodule is a top-level folder named like its repo, with a homepage, listed in the README
submodules=()
if [ -f .gitmodules ]; then
  mapfile -t submodules < <(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' | awk '{print $2}')
fi
for m in "${submodules[@]}"; do
  [[ "$m" =~ ^[a-z0-9-]+$ ]] || fail "submodule $m: must be a top-level folder"
  url=$(git config -f .gitmodules --get "submodule.$m.url" || true)
  [[ "$url" =~ (github\.com[:/]rojosinalma/$m(\.git)?)$ ]] || fail "submodule $m: url $url does not point at rojosinalma/$m"
  git config -f .gitmodules --get "submodule.$m.homepage" >/dev/null || fail "submodule $m: no homepage key"
  printf '%s\n' "${readme_tools[@]}" | grep -qx "$m" || fail "submodule $m: no README index row"
done

# README rows that are not submodules yet are allowed, but reported
for t in "${readme_tools[@]}"; do
  printf '%s\n' "${submodules[@]}" | grep -qx "$t" || note "$t is in the index but not a submodule yet"
done

# Checkout: every submodule initialised and at the recorded commit
if [ "${#submodules[@]}" -gt 0 ]; then
  while read -r line; do
    case "$line" in
      -*) fail "submodule not initialised: ${line#-}" ;;
      +*) fail "submodule checkout differs from the recorded commit: ${line#+}" ;;
      U*) fail "submodule has merge conflicts: ${line#U}" ;;
    esac
  done < <(git submodule status)
fi

# Leaks in tracked files of this repo (submodules check themselves)
patterns=(
  '/home/[a-z_][a-z0-9_-]*/'
  '\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b[a-z0-9-]+\.(internal|lan|local)\b'
)
extra="${OCTOFORGE_LEAK_PATTERNS:-$(git rev-parse --git-path info/leak-patterns)}"
if [ -f "$extra" ]; then
  while IFS= read -r p; do [ -n "$p" ] && [ "${p#\#}" = "$p" ] && patterns+=("$p"); done < "$extra"
fi
for p in "${patterns[@]}"; do
  hits=$(git grep -nIE -e "$p" -- . ':!LICENSE' ':!bin/verify' 2>/dev/null | grep -v 'example\.internal' || true)
  [ -z "$hits" ] || fail "possible leak ($p):"$'\n'"$hits"
done

[ "$errors" -eq 0 ] || { echo "verify: $errors check(s) failed" >&2; exit 1; }
echo "verify: index OK (${#readme_tools[@]} tools indexed, ${#submodules[@]} submodules)"

if [[ "${SKIP_APP:-0}" == "1" ]]; then
  echo "verify: app skipped (SKIP_APP=1)"
  echo "verify: OK"
  exit 0
fi

# --- App ----------------------------------------------------------------------------------------

IMAGE="${VERIFY_IMAGE:-octoforge:verify}"
HEALTH_TIMEOUT="${VERIFY_HEALTH_TIMEOUT:-30}"
container=""

die() {
  echo "verify: FAIL $1" >&2
  exit 1
}

cleanup() {
  if [[ -n "$container" ]]; then
    docker rm -f "$container" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

step() {
  local name=$1
  shift
  echo "verify: $name"
  "$@" || die "$name"
}

command -v bun >/dev/null 2>&1 || die "bun (not installed; see CONTRIBUTING.md)"
step install bun install --frozen-lockfile
step typecheck bun run typecheck
step lint bun run lint
step test bun test
step build bun run build

if [[ "${SKIP_DOCKER:-0}" == "1" ]]; then
  echo "verify: docker skipped (SKIP_DOCKER=1)"
  echo "verify: OK"
  exit 0
fi

command -v docker >/dev/null 2>&1 || die "docker (not installed; set SKIP_DOCKER=1 to skip)"
step docker-build docker build -t "$IMAGE" .

# Fail-closed start-up: without an auth decision the container must exit, not serve.
echo "verify: docker-refuses-without-auth"
if docker run --rm "$IMAGE" >/dev/null 2>&1; then die "docker-refuses-without-auth (container started without AUTH_PASSWORD)"; fi

echo "verify: docker-run"
container=$(docker run --rm -d -p 127.0.0.1:0:3000 -e AUTH_PASSWORD=verify "$IMAGE") || die docker-run

port=$(docker port "$container" 3000/tcp | head -n1 | sed 's/.*://') || die docker-port
[[ -n "$port" ]] || die docker-port

echo "verify: health (http://127.0.0.1:${port}/health, up to ${HEALTH_TIMEOUT}s)"
ok=0
for ((i = 0; i < HEALTH_TIMEOUT; i++)); do
  if curl -fsS -o /dev/null "http://127.0.0.1:${port}/health"; then
    ok=1
    break
  fi
  if ! docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -q true; then
    break
  fi
  sleep 1
done

if [[ "$ok" != "1" ]]; then
  echo "verify: container logs:" >&2
  docker logs "$container" >&2 2>&1 || true
  die health
fi

curl -fsS "http://127.0.0.1:${port}/health"
echo
code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${port}/api/members")
[[ "$code" == "401" ]] || die "api-gated (GET /api/members answered $code without a session, expected 401)"
echo "verify: OK"
